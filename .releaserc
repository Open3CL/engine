{
  "branches": [{ name: 'main' }],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          {
            "type": "chore",
            "scope": "deps",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "refactor",
            "release": "patch"
          }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm run reports:stamp ${nextRelease.version}",
        "publishCmd": "npm run version:update ${nextRelease.version}"
      }
    ],
    ["@semantic-release/npm", {
      "npmPublish": true,
      "pkgRoot": "src"
     }],
     ["@semantic-release/git", {
        "assets": [
          "package.json",
          "README.md",
          "docs/CORPUS-HISTORY.md",
          "docs/corpus-history.json",
          "dist/reports/corpus/corpus_history.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
     }],
    "@semantic-release/github"
  ]
}
