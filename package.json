{
  "name": "@open3cl/engine",
  "version": "0.1.0",
  "description": "Open Source 3CL-DPE engine",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "http-server": "http-server",
    "test": "vitest run src",
    "test:unit": "vitest run src",
    "test:unit:ci": "vitest run src --coverage",
    "test:corpus": "node test/corpus/run_all_corpus_checks.js",
    "test:corpus:all": "npm run reports:clean && node test/corpus/run_all_corpus_checks.js && npm run reports:readme",
    "test:corpus:all+database": "npm run test:corpus:all && node test/corpus/corpus_database.js",
    "test:corpus:one": "npm run test:corpus -- corpus-file-path=dpe_maison_individuelle_2026.csv",
    "qa:lint": "eslint .",
    "qa:lint:fix": "npm run qa:lint -- --fix",
    "qa:duplication": "jscpd",
    "qa:format": "prettier --plugin-search-dir . --write .",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "prepare": "husky",
    "types:generate": "node scripts/generate_types_from_xsd.js && prettier --write src/features/dpe/domain/models/dpe-xsd.generated.ts",
    "assets:sync": "node scripts/synchronize_assets.js",
    "version:update": "node scripts/update_version.js",
    "reports:preview": "npm run http-server dist/reports/corpus -o",
    "reports:clean": "node scripts/clean_corpus_reports.js",
    "reports:readme": "node scripts/generate_corpus_readme.js",
    "reports:stamp": "node scripts/stamp_corpus_release.js",
    "reports:version": "node scripts/corpus_version.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open3CL/engine.git"
  },
  "keywords": [
    "dpe",
    "3cl"
  ],
  "dependencies": {
    "dioma": "^0.4.6",
    "fast-xml-parser": "^5.11.2",
    "lodash-es": "^4.18.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@duckdb/node-api": "^2.0.0-r.1",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ansi-colors": "^4.1.3",
    "cli-progress": "^3.12.0",
    "deep-object-diff": "^1.1.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-csv": "^5.0.8",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "js-yaml": "^5.5.0",
    "jscpd": "^5.4.2",
    "piscina": "^5.3.2",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.0.0",
    "semantic-release": "^25.0.9",
    "vitest": "^5.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "author": "Open3Cl",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.1"
  },
  "bugs": {
    "url": "https://github.com/Open3CL/engine/issues"
  },
  "homepage": "https://github.com/Open3CL/engine#readme"
}
